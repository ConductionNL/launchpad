<?xml version="1.0"?>
<ruleset name="launchpad"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset_xml_schema.xsd">
    <description>launchpad — Conduction PHPMD ruleset (single source: conduction/hydra-gates).</description>

    <!-- Deviations from the central ruleset go BELOW this line, each with a
         reason. Everything else comes from conduction/hydra-gates. -->
    <rule ref="vendor/conduction/hydra-gates/quality-config/phpmd.xml">
        <exclude name="ExcessiveClassLength"/>
    </rule>

    <!-- Raise threshold to 1050 to accommodate the few large but well-structured
         service classes (e.g. NewsWidgetService) that consolidate complex
         domain logic as permitted by ADR conventions. Classes still enforced
         not to grow beyond this point. -->
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties>
            <property name="minimum" value="1050"/>
        </properties>
    </rule>
</ruleset>
