{
  "$schema": "https://github.com/ConductionNL/nextcloud-vue/raw/main/src/schemas/app-manifest-v2.schema.json",
  "setup": {
    "version": 1,
    "completionConfigKey": "setup_completed_version",
    "steps": [
      {
        "id": "welcome",
        "type": "info",
        "title": "Welcome",
        "body": "A short setup to get this app ready. Nothing here is required; you can close it and come back later."
      },
      {
        "id": "demo-data",
        "type": "run-action",
        "action": "install-demo-data",
        "title": "Demo data (optional)",
        "required": false,
        "body": "Load a small example dataset so the lists, detail pages and dashboards show a working product straight away. The data is obviously sample data, it is safe to run more than once, and it can be removed afterwards. Skip this on a production install."
      },
      {
        "id": "done",
        "type": "summary",
        "title": "All set"
      }
    ]
  },
  "version": "0.2.0",
  "dependencies": [],
  "observability": {
    "_note": "LaunchPad consumes the OpenRegister AppHost observability engine (ADR-040). These descriptors reproduce the output of the now-deleted hand-written HealthController + MetricsController. The /api/health and /api/metrics routes are aliased to the AppHost generic controllers in lib/AppInfo/Application.php, so the engine reads this block at request time. The Prometheus prefix is the runtime app id `launchpad`. Parity: implicit launchpad_info/launchpad_up plus launchpad_dashboards_total/widgets_total/tiles_total match the pre-adoption contract; documented intentional improvements are the now-public health endpoint and the added health `app`/`version` fields (ADR-006).",
    "health": {
      "statusCodePolicy": "adr006",
      "checks": [
        {
          "id": "database",
          "type": "database",
          "severity": "critical"
        }
      ]
    },
    "metrics": [
      {
        "name": "dashboards_total",
        "type": "gauge",
        "help": "Total dashboards by type",
        "source": {
          "kind": "tableCount",
          "table": "launchpad_dashboards",
          "groupBy": [
            "type"
          ],
          "labelDefaults": {
            "type": "personal"
          }
        }
      },
      {
        "name": "widgets_total",
        "type": "gauge",
        "help": "Total number of widget placements",
        "source": {
          "kind": "tableCount",
          "table": "launchpad_widget_placements"
        }
      },
      {
        "name": "tiles_total",
        "type": "gauge",
        "help": "Total number of tiles",
        "source": {
          "kind": "tableCount",
          "table": "launchpad_tiles"
        }
      }
    ]
  },
  "menu": [
    {
      "id": "dashboards",
      "label": "launchpad.menu.dashboards",
      "icon": "ViewDashboardOutline",
      "route": "dashboard-detail",
      "section": "main"
    },
    {
      "id": "admin-templates",
      "label": "launchpad.menu.adminTemplates",
      "icon": "FileReplaceOutline",
      "route": "/admin/templates",
      "section": "settings",
      "permission": "admin"
    },
    {
      "id": "admin-settings",
      "label": "launchpad.menu.adminSettings",
      "icon": "CogOutline",
      "route": "/admin/settings",
      "section": "settings",
      "permission": "admin"
    },
    {
      "id": "FlowsMenu",
      "label": "Flows",
      "icon": "Sitemap",
      "route": "Flows",
      "section": "settings",
      "order": 96
    },
    {
      "id": "Documentation",
      "label": "Documentation",
      "icon": "BookOpenVariantOutline",
      "href": "https://launchpad.conduction.nl",
      "section": "footer",
      "order": 90
    },
    {
      "id": "ReportsMenu",
      "label": "Reports",
      "icon": "ChartBoxOutline",
      "route": "Reports",
      "section": "footer",
      "order": 95
    },
    {
      "id": "FeaturesRoadmapMenu",
      "label": "Features & roadmap",
      "icon": "MapMarkerPath",
      "route": "FeaturesRoadmap",
      "section": "footer",
      "order": 100
    }
  ],
  "pages": [
    {
      "id": "dashboard-detail",
      "route": "/dashboards/:id",
      "type": "dashboard",
      "title": "launchpad.pages.dashboard",
      "_note": "Bundled STUB for the ADR-036 Decision-8 runtime-manifest pattern: the real per-user dashboard pages are assembled server-side by GET /apps/launchpad/api/manifest from the user's visible dashboards and replace this manifest at boot. widgets[] is intentionally empty here — LaunchPad has no static home page. The 'dashboards' menu entry targets this page by ID rather than by path, which is the pairing the SERVER emits: ManifestController::buildManifest() sets each menu entry's route to its page's id ('dashboard-'.$slug) while the page carries the path ('/'.$slug). The stub previously said '/dashboards' — a path matching neither this page ('/dashboards/:id') nor anything the runtime builder produces — so the single menu entry LaunchPad ships resolved to nothing.",
      "widgets": [],
      "config": {
        "documentationUrl": "https://launchpad.conduction.nl"
      }
    },
    {
      "id": "admin-templates-index",
      "route": "/admin/templates",
      "type": "custom",
      "title": "launchpad.pages.adminTemplates",
      "component": "TemplatesPage",
      "_note": "Admin CRUD over the launchpad app-config/templates table, rendered by LaunchPad's own admin chrome (src/components/admin/tabs/TemplatesPage.vue). No OpenRegister register/schema backs this data, so the declarative index page type (which requires register + schema) cannot apply.",
      "config": {
        "documentationUrl": "https://launchpad.conduction.nl"
      }
    },
    {
      "id": "admin-settings",
      "route": "/admin/settings",
      "type": "custom",
      "title": "launchpad.pages.adminSettings",
      "component": "AdminSettingsPage",
      "_note": "Bespoke admin settings surface (tile/template management forms) rendered by LaunchPad's own router; manages app-config state that no declarative widget vocabulary covers."
    },
    {
      "id": "Flows",
      "route": "/flows",
      "type": "index",
      "title": "Flows",
      "config": {
        "entitySource": "flows",
        "app": "launchpad"
      },
      "_note": "ADR-110 Decision 4: a flow is app-specific, so the authoring surface lives here rather than behind a deep link to another app's list. An ordinary index over the named `flows` source (config.entitySource) rather than the deprecated `flows` page type, reading OpenRegister's one native flow store (ADR-065), scoped to this app by config.app."
    },
    {
      "id": "FlowDetail",
      "route": "/flows/:id",
      "type": "flow",
      "title": "Flow",
      "config": {
        "app": "launchpad"
      },
      "_note": "The shared CnFlowDetail canvas over the same single engine. Controls render in the NC app sidebar so the canvas keeps full width."
    },
    {
      "id": "Reports",
      "_note": "ADR-112 / ADR-114 Decision 3. ONE card, deliberately. LaunchPad's register holds a single schema — dashboard — so a second report would either repeat this one or invent a reading the data cannot support. The `widgets` array holds widget descriptors rather than references, so grouping by it would bucket objects and render noise; it is left out rather than shipped as a chart that looks like an answer.",
      "route": "/reports",
      "type": "reports",
      "title": "Reports",
      "config": {
        "description": "Pick a report to open it.",
        "cards": [
          {
            "id": "DashboardsReport",
            "label": "Dashboards",
            "description": "How many dashboards there are, and who they belong to.",
            "icon": "ViewDashboardOutline",
            "route": "DashboardsReport"
          }
        ]
      }
    },
    {
      "id": "DashboardsReport",
      "route": "/reports/dashboards",
      "type": "dashboard",
      "title": "Dashboards",
      "_note": "Declarative over the app's own register. Every filter is scalar equality, the only kind OpenRegister's aggregation endpoint can evaluate: a multi-value or relative-date filter is accepted and then silently not applied.",
      "config": {
        "widgets": [
          {
            "id": "dash-total",
            "title": "Dashboards",
            "type": "stat",
            "content": {
              "label": "Dashboards",
              "icon": "ViewDashboardOutline",
              "route": {
                "name": "dashboards"
              },
              "format": {
                "style": "decimal",
                "decimals": 0
              },
              "source": {
                "register": "launchpad",
                "schema": "dashboard",
                "metric": "count"
              }
            }
          },
          {
            "id": "dash-personal",
            "title": "Personal",
            "type": "stat",
            "content": {
              "label": "Personal",
              "icon": "ViewDashboardOutline",
              "route": {
                "name": "dashboards"
              },
              "format": {
                "style": "decimal",
                "decimals": 0
              },
              "source": {
                "register": "launchpad",
                "schema": "dashboard",
                "metric": "count",
                "filter": {
                  "type": "user"
                }
              }
            }
          },
          {
            "id": "dash-shared",
            "title": "Shared with a group",
            "type": "stat",
            "content": {
              "label": "Shared with a group",
              "icon": "Sitemap",
              "route": {
                "name": "dashboards"
              },
              "format": {
                "style": "decimal",
                "decimals": 0
              },
              "source": {
                "register": "launchpad",
                "schema": "dashboard",
                "metric": "count",
                "filter": {
                  "type": "group_shared"
                }
              }
            }
          },
          {
            "id": "dash-templates",
            "title": "Admin templates",
            "type": "stat",
            "content": {
              "label": "Admin templates",
              "icon": "FileReplaceOutline",
              "route": {
                "name": "admin-templates"
              },
              "format": {
                "style": "decimal",
                "decimals": 0
              },
              "source": {
                "register": "launchpad",
                "schema": "dashboard",
                "metric": "count",
                "filter": {
                  "type": "admin_template"
                }
              }
            }
          },
          {
            "id": "dash-by-type",
            "title": "Who they belong to",
            "type": "chart",
            "content": {
              "chartKind": "donut",
              "legendPosition": "bottom",
              "emptyLabel": "No dashboards yet",
              "dataSource": {
                "register": "launchpad",
                "schema": "dashboard",
                "aggregate": {
                  "groupBy": "type",
                  "metric": "count"
                }
              }
            }
          },
          {
            "id": "dash-recent",
            "title": "Most recent",
            "type": "object-table",
            "content": {
              "register": "launchpad",
              "schema": "dashboard",
              "filter": {},
              "sort": {
                "field": "created",
                "dir": "desc"
              },
              "limit": 8,
              "hideHeader": true,
              "emptyText": "No dashboards yet",
              "viewAllRoute": {
                "name": "dashboards"
              },
              "viewAllLabel": "Open a dashboard",
              "columns": [
                {
                  "key": "title",
                  "label": "Dashboard"
                },
                {
                  "key": "type",
                  "label": "Kind"
                },
                {
                  "key": "version",
                  "label": "Version"
                }
              ]
            }
          }
        ],
        "layout": [
          {
            "id": "1",
            "widgetId": "dash-total",
            "gridX": 0,
            "gridY": 0,
            "gridWidth": 3,
            "gridHeight": 2,
            "showTitle": false
          },
          {
            "id": "2",
            "widgetId": "dash-personal",
            "gridX": 3,
            "gridY": 0,
            "gridWidth": 3,
            "gridHeight": 2,
            "showTitle": false
          },
          {
            "id": "3",
            "widgetId": "dash-shared",
            "gridX": 6,
            "gridY": 0,
            "gridWidth": 3,
            "gridHeight": 2,
            "showTitle": false
          },
          {
            "id": "4",
            "widgetId": "dash-templates",
            "gridX": 9,
            "gridY": 0,
            "gridWidth": 3,
            "gridHeight": 2,
            "showTitle": false
          },
          {
            "id": "5",
            "widgetId": "dash-by-type",
            "gridX": 0,
            "gridY": 2,
            "gridWidth": 12,
            "gridHeight": 4,
            "showTitle": true
          },
          {
            "id": "6",
            "widgetId": "dash-recent",
            "gridX": 0,
            "gridY": 6,
            "gridWidth": 12,
            "gridHeight": 4,
            "showTitle": true
          }
        ]
      }
    },
    {
      "id": "FeaturesRoadmap",
      "route": "/features-roadmap",
      "type": "roadmap",
      "title": "Features & roadmap",
      "config": {
        "documentationUrl": "https://launchpad.conduction.nl"
      },
      "_note": "ADR-018 / ADR-114 Decision 5. Rendered by the shared CnFeaturesAndRoadmapView, which reads the committed docs/features.json and OpenRegister's GitHub proxy. No per-app customisation of the view itself."
    }
  ],
  "walkthrough": {
    "enabled": true,
    "version": 1,
    "completionConfigKey": "walkthrough_completed_version",
    "tours": [
      {
        "id": "launchpad:getting-started",
        "title": "Getting started",
        "trigger": "first-visit",
        "steps": [
          {
            "id": "welcome",
            "placement": "center",
            "title": "Welcome to Launchpad",
            "body": "A short tour of the main screens. It takes under a minute, and you can close it at any point and pick it up again from the help menu.",
            "target": {
              "kind": "page",
              "ref": "dashboard-detail"
            },
            "advanceOn": {
              "type": "manual"
            }
          },
          {
            "id": "go-dashboard-detail",
            "placement": "right",
            "body": "Open Dashboards from the menu.",
            "task": "Click Dashboards in the menu",
            "target": {
              "kind": "nav-item",
              "ref": "dashboard-detail"
            },
            "advanceOn": {
              "type": "route-match",
              "route": "dashboard-detail"
            }
          },
          {
            "id": "go-flows",
            "placement": "right",
            "body": "Flows automate the repetitive parts of this app. Have a look, though you do not have to build one now.",
            "task": "Open Flows from the menu",
            "target": {
              "kind": "nav-item",
              "ref": "Flows"
            },
            "advanceOn": {
              "type": "route-match",
              "route": "Flows"
            },
            "allowManualNext": true
          }
        ]
      }
    ]
  }
}
