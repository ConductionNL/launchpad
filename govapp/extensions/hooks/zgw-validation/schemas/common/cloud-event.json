{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "urn:vng:zgw:common:cloud-event",
	"title": "CloudEvent",
	"description": "CloudEvents v1.0 schema voor gebruik in notificaties.",
	"type": "object",
	"required": ["specversion", "type", "source", "id"],
	"properties": {
		"specversion": {
			"type": "string",
			"const": "1.0",
			"description": "CloudEvents specificatieversie."
		},
		"type": {
			"type": "string",
			"description": "Type gebeurtenis."
		},
		"source": {
			"type": "string",
			"format": "uri-reference",
			"description": "De bron van de gebeurtenis."
		},
		"id": {
			"type": "string",
			"description": "Unieke identifier van de gebeurtenis."
		},
		"time": {
			"type": "string",
			"format": "date-time",
			"description": "Tijdstip van de gebeurtenis."
		},
		"subject": {
			"type": "string",
			"description": "Het onderwerp van de gebeurtenis."
		},
		"datacontenttype": {
			"type": "string",
			"description": "Content-type van de data."
		},
		"data": {
			"description": "De payload van de gebeurtenis."
		}
	}
}
