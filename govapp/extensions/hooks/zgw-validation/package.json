{
	"name": "zgw-validation",
	"version": "1.0.0",
	"description": "Directus Hook extension for JSON Schema validation of ZGW resources",
	"type": "module",
	"directus:extension": {
		"type": "hook",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^10.0.0 || ^11.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"test": "vitest run",
		"test:watch": "vitest",
		"validate-schemas": "tsx scripts/validate-schemas.ts"
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "^12.0.0",
		"@types/node": "^20.14.0",
		"tsx": "^4.19.0",
		"typescript": "^5.5.0",
		"vitest": "^2.1.0"
	}
}
