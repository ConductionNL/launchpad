{
  "components": {
    "registers": {
      "launchpad": {
        "schemas": [
          "filter_event"
        ]
      }
    },
    "schemas": {
      "filter_event": {
        "slug": "filter_event",
        "icon": "ChartTimelineVariant",
        "version": "1.0.0",
        "title": "Filter event",
        "description": "One filter change on a dashboard, kept only when filter telemetry is on. It holds the dimensions and operators, never the filter values.",
        "type": "object",
        "x-openregister": {
          "active": true,
          "hardDelete": false,
          "searchable": false,
          "mailEnabled": false
        },
        "required": [
          "dashboardId",
          "userId",
          "eventType",
          "filterDelta",
          "timestamp"
        ],
        "properties": {
          "dashboardId": {
            "type": "string",
            "format": "uuid",
            "title": "Dashboard",
            "description": "The dashboard the change was made on."
          },
          "userId": {
            "type": "string",
            "title": "User",
            "description": "The user who made the change."
          },
          "widgetId": {
            "type": "string",
            "title": "Widget",
            "description": "The widget clicked, for a widget click."
          },
          "eventType": {
            "type": "string",
            "title": "Event type",
            "description": "What happened.",
            "enum": [
              "apply",
              "reset",
              "bookmark",
              "share"
            ]
          },
          "filterDelta": {
            "type": "array",
            "title": "Filter change",
            "description": "The clauses added or removed, without their values.",
            "items": {
              "type": "object",
              "required": [
                "dimension",
                "operator"
              ],
              "additionalProperties": false,
              "properties": {
                "dimension": {
                  "type": "string",
                  "title": "Dimension",
                  "description": "The filtered attribute, such as gemeenteCode or period.month.",
                  "minLength": 1
                },
                "operator": {
                  "type": "string",
                  "title": "Operator",
                  "description": "How the value is compared.",
                  "enum": [
                    "eq",
                    "in",
                    "between",
                    "gte",
                    "lte",
                    "contains",
                    "notNull"
                  ]
                },
                "source": {
                  "type": "string",
                  "title": "Source",
                  "description": "Where the clause came from.",
                  "enum": [
                    "userExplicit",
                    "widgetClick",
                    "urlBootstrap",
                    "savedView",
                    "parentScope"
                  ]
                },
                "sourceWidgetId": {
                  "type": "string",
                  "title": "Source widget",
                  "description": "The widget a widget click came from."
                },
                "pinned": {
                  "type": "boolean",
                  "title": "Pinned",
                  "description": "A pinned clause survives Reset filters.",
                  "default": false
                }
              }
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Time",
            "description": "When the change was made."
          }
        }
      }
    }
  }
}
