            "slug": "consultancy-werkplek",
            "title": "Consultancy Werkplek",
            "description": "Werkplek voor consultants met projectoverzicht, taken en tijdregistratie",
            "version": "1.0.0",
            "widgets": [
              {
                "widgetKey": "recommendations",
                "slot": "main",
                "gridX": 0,
