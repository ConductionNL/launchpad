                "gridWidth": 4,
                "gridHeight": 4
              }
            ],
            "sharedWith": [],
            "isDefault": true
          },
          {
            "@self": {
              "register": "launchpad",
              "schema": "Dashboard",
              "slug": "consultancy-werkplek"
