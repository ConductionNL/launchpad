          {
            "@self": {
              "register": "launchpad",
              "schema": "Dashboard",
              "slug": "active-campaigns"
            },
            "slug": "active-campaigns",
            "title": "Active Campaigns",
            "description": "Marketing team shared dashboard, scoped to the 'marketing' group",
            "version": "1.0.0",
            "type": "group_shared",
            "groupId": "marketing",
            "widgets": [
              {
                "widgetKey": "kpi-tile",
                "slot": "main",
                "gridX": 0,
