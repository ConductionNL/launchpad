{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "urn:vng:zgw:ztc:1.3.1:informatieobjecttype",
	"title": "InformatieObjectType",
	"description": "Een informatieobjecttype uit de Catalogus API.",
	"type": "object",
	"required": ["catalogus", "omschrijving", "vertrouwelijkheidaanduiding", "beginGeldigheid"],
	"properties": {
		"catalogus": {
			"type": "string",
			"format": "uri",
			"description": "URL-referentie naar de catalogus."
		},
		"omschrijving": {
			"type": "string",
			"maxLength": 80,
			"description": "Omschrijving van het informatieobjecttype."
		},
		"vertrouwelijkheidaanduiding": {
			"type": "string",
			"enum": [
				"openbaar", "beperkt_openbaar", "intern", "zaakvertrouwelijk",
				"vertrouwelijk", "confidentieel", "geheim", "zeer_geheim"
			]
		},
		"beginGeldigheid": {
			"type": "string",
			"format": "date"
		},
		"eindeGeldigheid": {
			"type": ["string", "null"],
			"format": "date"
		},
		"concept": {
			"type": "boolean"
		}
	},
	"additionalProperties": false
}
