{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "urn:vng:zgw:zrc:1.5.1:zaakobject",
	"title": "ZaakObject",
	"description": "De relatie tussen een zaak en een object.",
	"type": "object",
	"required": ["zaak", "objectType"],
	"properties": {
		"zaak": {
			"type": "string",
			"format": "uri",
			"description": "URL-referentie naar de zaak."
		},
		"object": {
			"type": "string",
			"format": "uri",
			"description": "URL-referentie naar het object."
		},
		"objectType": {
			"type": "string",
			"enum": [
				"adres", "besluit", "buurt", "enkelvoudig_document",
				"gemeente", "gemeentelijke_openbare_ruimte", "huishouden",
				"inrichtingselement", "kadastrale_onroerende_zaak", "kunstwerkdeel",
				"maatschappelijke_activiteit", "medewerker", "natuurlijk_persoon",
				"niet_natuurlijk_persoon", "openbare_ruimte", "organisatorische_eenheid",
				"pand", "spoorbaandeel", "status", "terreindeel", "terrein_gebouwd_object",
				"vestiging", "waterdeel", "wegdeel", "wijk", "woonplaats",
				"woz_deelobject", "woz_object", "woz_waarde", "zakelijk_recht",
				"overige"
			],
			"description": "Beschrijft het type object dat de zaak gerelateerd is."
		},
		"objectTypeOverige": {
			"type": "string",
			"maxLength": 100,
			"description": "Beschrijft het type object als objectType 'overige' is."
		},
		"relatieomschrijving": {
			"type": "string",
			"maxLength": 80,
			"description": "Omschrijving van de relatie tussen de zaak en het object."
		},
		"objectTypeOverigeDefinitie": {
			"type": ["object", "null"],
			"properties": {
				"url": {
					"type": "string",
					"format": "uri"
				},
				"schema": {
					"type": "string"
				},
				"objectData": {
					"type": "string"
				}
			}
		}
	},
	"additionalProperties": false
}
