{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "urn:vng:zgw:ztc:1.3.1:statustype",
	"title": "StatusType",
	"description": "Een statustype behorend bij een zaaktype.",
	"type": "object",
	"required": ["omschrijving", "zaaktype", "volgnummer"],
	"properties": {
		"omschrijving": {
			"type": "string",
			"maxLength": 80,
			"description": "Omschrijving van het statustype."
		},
		"omschrijvingGeneriek": {
			"type": "string",
			"maxLength": 80,
			"description": "Generieke omschrijving."
		},
		"statustekst": {
			"type": "string",
			"maxLength": 1000,
			"description": "Tekst die wordt weergegeven bij de status."
		},
		"zaaktype": {
			"type": "string",
			"format": "uri",
			"description": "URL-referentie naar het zaaktype."
		},
		"volgnummer": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9999,
			"description": "Volgnummer van het statustype binnen het zaaktype."
		},
		"isEindstatus": {
			"type": "boolean",
			"description": "Geeft aan of dit de eindstatus is."
		},
		"informeren": {
			"type": "boolean",
			"description": "Of de initiator geinformeerd moet worden bij het bereiken van deze status."
		},
		"doorlooptijd": {
			"type": ["string", "null"],
			"description": "ISO 8601 duration"
		},
		"toelichting": {
			"type": "string",
			"maxLength": 1000
		},
		"beginGeldigheid": {
			"type": ["string", "null"],
			"format": "date"
		},
		"eindeGeldigheid": {
			"type": ["string", "null"],
			"format": "date"
		}
	},
	"additionalProperties": false
}
