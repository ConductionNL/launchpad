              }
            ],
            "sharedWith": [],
            "isDefault": false
          },
          {
            "@self": {
              "register": "launchpad",
              "schema": "Dashboard",
              "slug": "welcome-to-launchpad"
            },
            "slug": "welcome-to-launchpad",
            "title": "Welcome to LaunchPad",
            "description": "Default landing dashboard visible to every user, powered by the 'default' synthetic group",
            "version": "1.0.0",
            "type": "group_shared",
            "groupId": "default",
            "widgets": [
              {
                "widgetKey": "announcements",
