{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "urn:vng:zgw:common:pagination",
	"title": "Paginated Response",
	"description": "Standaard paginatie-response conform VNG ZGW API standaard.",
	"type": "object",
	"required": ["count", "results"],
	"properties": {
		"count": {
			"type": "integer",
			"minimum": 0,
			"description": "Totaal aantal resultaten."
		},
		"next": {
			"type": ["string", "null"],
			"format": "uri",
			"description": "URL naar de volgende pagina."
		},
		"previous": {
			"type": ["string", "null"],
			"format": "uri",
			"description": "URL naar de vorige pagina."
		},
		"results": {
			"type": "array",
			"description": "De resultaten op deze pagina."
		}
	}
}
