{
  "name": "sendentworkspace",
  "version": "1.0.0",
  "description": "Customizable workspace with dynamic grid layout for Nextcloud",
  "author": {
    "name": "Luc Pasmans",
    "email": "l.pasmans@sendent.com"
  },
  "private": true,
  "scripts": {
    "build": "NODE_ENV=production webpack --progress --config webpack.js",
    "building": "powershell -Command \"$env:NODE_ENV='production'; webpack --progress --config webpack.js\"",
    "dev": "NODE_ENV=development webpack --progress --config webpack.js",
    "developing": "powershell -Command \"$env:NODE_ENV='development'; webpack --progress --config webpack.js\"",
    "watch": "NODE_ENV=development webpack --progress --watch --config webpack.js",
    "lint": "eslint src",
    "stylelint": "stylelint src/**/*.vue src/**/*.scss src/**/*.css"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.5.1",
    "@nextcloud/dialogs": "^7.1.0",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.0",
    "@nextcloud/router": "^3.0.1",
    "dompurify": "^3.3.1",
    "gridstack": "^12.2.1",
    "vue": "3.5.15",
    "vue-material-design-icons": "^5.3.1",
    "vuedraggable": "^4.1.0"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  },
  "devDependencies": {
    "@nextcloud/babel-config": "^1.3.0",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^8.4.2",
    "@nextcloud/stylelint-config": "^3.0.1",
    "@nextcloud/webpack-vue-config": "6.3.0",
    "eslint-webpack-plugin": "^4.1.0",
    "stylelint-webpack-plugin": "^5.0.0",
    "webpack": "^5.99.9",
    "webpack-cli": "6.0.1"
  }
}
